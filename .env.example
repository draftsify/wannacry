# ---------------------------------------------------------------------------
# Database (Neon / Supabase / any Postgres)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
# Non-pooled connection. Prisma migrations need this when DATABASE_URL is a pooler.
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
# Must support getProgramAccounts — the public mainnet endpoint does not, and the
# epoch snapshot will fail against it. Helius or Triton work.
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=..."
NEXT_PUBLIC_SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=..."
NEXT_PUBLIC_SOLANA_CLUSTER="mainnet-beta"

# Patient Zero: the token whose fees fund the treasury.
NEXT_PUBLIC_MAIN_MINT=""
NEXT_PUBLIC_MAIN_SYMBOL="MAIN"

# Treasury. Run `npm run treasury:new` to generate one and fill both of these.
# MVP trust assumption: this is a hot key that can spend epoch capital. Keep only
# one epoch's worth of SOL on it. Phase 4 replaces it with a program PDA.
NEXT_PUBLIC_TREASURY_PUBKEY=""
TREASURY_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Protocol parameters
# ---------------------------------------------------------------------------
EPOCH_DURATION_HOURS="24"
# Share of the treasury released per epoch, in basis points. 2000 = 20%.
DISTRIBUTION_BPS="2000"
TREASURY_RESERVE_LAMPORTS="50000000"
# Minimum raw Main Token balance to be eligible. Set this meaningfully above zero
# before launch — it is the only anti-Sybil measure in the equal-split formula.
MIN_HOLDING_RAW="1"
MIN_ALLOCATION_LAMPORTS="1000000"
DEFAULT_SLIPPAGE_BPS="100"
MAX_SLIPPAGE_BPS="1500"
MAX_PRICE_IMPACT_PCT="15"
INTENT_TTL_SECONDS="180"

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Signs session cookies. Any long random string: `openssl rand -hex 32`.
SESSION_SECRET=""
# Bearer token guarding /api/cron/*.
CRON_SECRET=""
NEXT_PUBLIC_APP_DOMAIN="localhost:3000"

# ---------------------------------------------------------------------------
# Jupiter (optional — free tier needs no key)
# ---------------------------------------------------------------------------
JUPITER_API_BASE="https://lite-api.jup.ag/swap/v1"
JUPITER_TOKEN_API_BASE="https://lite-api.jup.ag/tokens/v2"
JUPITER_API_KEY=""
